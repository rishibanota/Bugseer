# ============================================================================
# BugSeer environment configuration
# ============================================================================
# Copy this file to `.env` and edit it:      cp .env.example .env
#
#   >>> EVERY VARIABLE IN THIS FILE IS OPTIONAL. <<<
#
# BugSeer is designed to run 100% offline. Static analysis, git intelligence,
# the dependency graph, the local ML model and the dashboard all work with NO
# API keys and NO network access. Your source code never leaves your machine.
#
# The keys below only enable ONE optional convenience feature: the
# "AI narrator" (`bugseer explain <file> --narrate`), which rewrites BugSeer's
# already-computed, deterministic evidence into prose. It changes *wording*,
# never the risk score.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Optional AI narrator: pick at most one provider
# ----------------------------------------------------------------------------
# Leave BUGSEER_AI_PROVIDER empty (or set it to "none") to stay fully offline.
# Valid values: none | openai | anthropic | gemini | ollama
BUGSEER_AI_PROVIDER=none

# --- OpenAI --------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override for Azure OpenAI, LiteLLM, OpenRouter or any OpenAI-compatible proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Google (Gemini) ------------------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Ollama / local LLM (still offline, no key needed) --------------------
# Run a model on your own hardware; nothing is sent to a third party.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# ----------------------------------------------------------------------------
# 2. Privacy guard for the narrator
# ----------------------------------------------------------------------------
# When 0 (default) BugSeer sends ONLY the numeric metrics and rule names
# (e.g. {"file": "payment.py", "cyclomatic": 41, "rules": ["no-error-handling"]}).
# Set to 1 to also include source snippets in the prompt. Never enable this on
# a private or regulated codebase you are not allowed to transmit.
BUGSEER_AI_SEND_SOURCE=0

# Redact file paths to hashes before sending anything to a remote provider.
BUGSEER_AI_REDACT_PATHS=0

# Hard kill-switch: 1 blocks every outbound network call, even if a key is set.
BUGSEER_OFFLINE=0

# Seconds to wait for the provider before giving up and printing plain evidence.
BUGSEER_AI_TIMEOUT=30


# ----------------------------------------------------------------------------
# 3. Analysis tuning (optional - CLI flags and .bugseer.toml take precedence)
# ----------------------------------------------------------------------------
# Where BugSeer stores its cache, trained model and scan snapshots.
BUGSEER_HOME=.bugseer

# Number of days of git history to analyse. 0 = full history.
BUGSEER_HISTORY_DAYS=730

# Extra regex (case-insensitive) that marks a commit as a bug fix, on top of
# the built-in list (fix|bug|hotfix|patch|regression|crash|...).
BUGSEER_BUGFIX_PATTERN=

# Path to a coverage report. Auto-detected if omitted:
# coverage.xml | lcov.info | coverage.json | .coverage
BUGSEER_COVERAGE_FILE=

# Parallel worker processes for scanning. 0 = auto (CPU count).
BUGSEER_WORKERS=0

# Dashboard bind address for `bugseer serve`.
BUGSEER_HOST=127.0.0.1
BUGSEER_PORT=8420
